# What Cloud Build receives for `gcloud run deploy --source .`
#
# Inherit the repository exclusions first, then add build-only exclusions.
# This keeps local-only files out of Cloud Build even when they are untracked
# on the machine running the deploy.
#
# The service reads src/, the Aug 22 JSON/text state (including
# embeddings.json + reshoot_edges.json), and the twelve tracked
# candidate photos explicitly allowed below.

.git/
.gcloudignore
#!include:.gitignore

# local agent/browser state; may contain authenticated URLs or account data
.claude/
.playwright-mcp/

# heavy artifacts the runtime never opens
docs/screenshots/
docs/*.png
artifacts/

# Runtime image endpoints need exactly these tracked candidate photos.
!data/aug22_gallery_4160518/images/
data/aug22_gallery_4160518/images/*
!data/aug22_gallery_4160518/images/001_838421457.jpg
!data/aug22_gallery_4160518/images/002_838421481.jpg
!data/aug22_gallery_4160518/images/016_838421603.jpg
