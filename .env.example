# Copy to .env. None of this is needed for `make demo`.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global            # gemini-3.5 is not in every regional endpoint; verify in console
CLOUD_RUN_REGION=us-central1      # pinned separately from the model endpoint
BTF_CYCLE_BUCKET=                # defaults to <project>-blue-toad-cycles
BTF_CYCLE_JOB=blue-toad-cycle-processor
BTF_SHOP_ID=richmond-general
BTF_OPERATOR_SECRET=operator-token # Secret Manager name used during deployment
OPERATOR_TOKEN=                  # local development only; production reads the secret
OPERATOR_ACTOR=richmond-general-owner # durable audit identity for shared-token mutations
FIRESTORE_DATABASE=(default)
BROKER_URL=
SLACK_WEBHOOK_URL=                # incoming webhook, not an OAuth app
BUDGET_CAP=2205.00
AUTO_SEND_THRESHOLD=0.00          # 0 = every bid needs a human. Raise deliberately.
