# Copy to .env. None of this is needed for `make demo`.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global            # gemini-3.5 is not in every regional endpoint; verify in console
CLOUD_RUN_REGION=us-central1      # pinned separately from the model endpoint
FIRESTORE_DATABASE=(default)
GALLERY_BUCKET=
BROKER_URL=
SLACK_WEBHOOK_URL=                # incoming webhook, not an OAuth app
BUDGET_CAP=2205.00
AUTO_SEND_THRESHOLD=0.00          # 0 = every bid needs a human. Raise deliberately.
